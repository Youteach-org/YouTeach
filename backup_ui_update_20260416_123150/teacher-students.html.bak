<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>YouTeach - Students</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <button id="menuToggle" class="hamburger-btn" aria-label="Open menu">
    <span></span><span></span><span></span>
  </button>

  <div class="menu-shell">
    <aside id="sidebar" class="sidebar collapsible-sidebar">
      <div class="brand">
        <h1>YouTeach</h1>
        <p>Teacher Menu</p>
      </div>

      <div class="sidebar-links">
        <a class="sidebar-link" href="teacher.html">Teacher Home</a>
        <a class="sidebar-link active-link" href="teacher-students.html">Students</a>
        <a class="sidebar-link" href="teacher-enrollment.html">Groups / Import</a>
        <a class="sidebar-link" href="teacher-active.html">Active Today</a>
        <a class="sidebar-link" href="teacher-points.html">Points / Export</a>
        <a class="sidebar-link" href="teacher-history.html">History</a>
        <a class="sidebar-link" href="buzzer.html">Buzzer</a>
        <button id="logoutBtn" class="logout-btn">Logout</button>
      </div>
    </aside>

    <main class="main-content">
      <header class="topbar">
        <div>
          <h2>Students</h2>
          <p>Choose a group first, then search students inside that group</p>
        </div>
        <div class="topbar-right">
          <span id="teacherIdentity" class="teacher-identity">Teacher</span>
        </div>
      </header>

      <div class="section-grid two-columns">
        <div class="panel-card">
          <div class="panel-card-header">
            <h3>Group Filter</h3>
          </div>
          <div class="toolbar-row">
            <select id="groupFilter"></select>
          </div>
        </div>

        <div class="panel-card">
          <div class="panel-card-header">
            <h3>Selected Group</h3>
          </div>
          <div class="student-info-grid">
            <div class="summary-card mini">
              <span class="summary-label">Group</span>
              <strong id="selectedGroupCard">---</strong>
            </div>
            <div class="summary-card mini">
              <span class="summary-label">Students in Group</span>
              <strong id="studentsInGroupCard">0</strong>
            </div>
          </div>
        </div>
      </div>

      <div class="panel-card">
        <div class="toolbar-row">
          <input id="searchStudent" placeholder="Search by name, nickname, external ID, or internal ID">
        </div>

        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Full Name</th>
                <th>Nickname</th>
                <th>External ID</th>
                <th>Internal ID</th>
                <th>Today Active</th>
                <th>Block 1</th>
                <th>Block 2</th>
                <th>Block 3</th>
                <th>Edit Nickname</th>
                <th>Edit Group</th>
                <th>Save</th>
              </tr>
            </thead>
            <tbody id="studentsTableBody">
              <tr>
                <td colspan="11">No students found.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <script type="module" src="teacher-students.js"></script>
</body>
</html>