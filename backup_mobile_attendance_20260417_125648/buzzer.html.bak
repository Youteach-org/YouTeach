<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>YouTeach - Buzzer</title>
  <link rel="stylesheet" href="styles.css">
  <style>
    .buzzer-summary-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
      margin-bottom: 14px;
    }

    .buzzer-summary-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 10px 12px;
      box-shadow: 0 4px 10px rgba(15,23,42,0.04);
    }

    .buzzer-summary-card .label {
      display: block;
      font-size: 11px;
      color: #64748b;
      margin-bottom: 4px;
    }

    .buzzer-summary-card strong {
      display: block;
      font-size: 16px;
      line-height: 1.1;
    }

    .generator-details {
      margin-bottom: 14px;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 10px rgba(15,23,42,0.04);
    }

    .generator-details summary {
      cursor: pointer;
      list-style: none;
      padding: 12px 14px;
      font-weight: 700;
      background: #f8fafc;
    }

    .generator-details summary::-webkit-details-marker {
      display: none;
    }

    .generator-content {
      padding: 14px;
      display: grid;
      gap: 14px;
    }

    .generator-section {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 12px;
    }

    .generator-section h4 {
      margin: 0 0 10px 0;
      font-size: 14px;
    }

    .generator-mini-note {
      margin-top: 8px;
      font-size: 12px;
      color: #64748b;
    }

    .generator-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 10px;
    }

    .generator-actions button {
      flex: 0 0 auto;
      min-width: 140px;
      padding: 9px 12px;
      font-size: 13px;
    }

    .buzzer-main-grid {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      gap: 14px;
    }

    .buzz-panel,
    .score-panel {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 14px;
      padding: 14px;
      box-shadow: 0 4px 10px rgba(15,23,42,0.04);
    }

    .panel-title {
      margin: 0 0 10px 0;
      font-size: 18px;
    }

    .buzz-result-card {
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      border-radius: 12px;
      padding: 12px;
      margin-bottom: 12px;
    }

    .buzz-result-card h3 {
      margin: 0 0 10px 0;
      font-size: 18px;
    }

    .buzz-result-mini {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }

    .buzz-result-mini div {
      background: #ffffff;
      border: 1px solid #dbeafe;
      border-radius: 10px;
      padding: 8px 10px;
      font-size: 13px;
      line-height: 1.3;
    }

    .control-buttons-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-bottom: 12px;
    }

    .control-buttons-grid button {
      width: 100%;
      min-height: 42px;
      font-size: 13px;
    }

    .teacher-note {
      color: #64748b;
      font-size: 12px;
      margin: 0;
    }

    .live-score-list {
      display: grid;
      gap: 10px;
    }

    .live-score-card {
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 10px 12px;
      background: #f8fafc;
    }

    .live-score-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 8px;
    }

    .live-score-top strong {
      font-size: 16px;
    }

    .live-score-points {
      font-size: 15px;
      font-weight: 700;
      color: #1d4ed8;
    }

    .team-members {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .team-member-chip {
      background: #ffffff;
      border: 1px solid #d1d5db;
      border-radius: 999px;
      padding: 4px 8px;
      font-size: 12px;
      line-height: 1.1;
    }

    .empty-state {
      color: #64748b;
      font-size: 13px;
    }

    @media (max-width: 900px) {
      .buzzer-summary-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .buzzer-main-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 600px) {
      .buzzer-summary-card {
        padding: 8px 10px;
      }

      .buzzer-summary-card strong {
        font-size: 14px;
      }

      .buzz-result-mini {
        grid-template-columns: 1fr;
      }

      .control-buttons-grid {
        grid-template-columns: 1fr 1fr;
      }

      .generator-actions button {
        min-width: 100%;
      }
    }
  </style>
</head>
<body>
  <button id="menuToggle" class="hamburger-btn" aria-label="Open menu">
    <span></span><span></span><span></span>
  </button>

  <div class="menu-shell">
    <aside id="sidebar" class="sidebar collapsible-sidebar">
      <div class="brand">
        <h1>YouTeach</h1>
        <p>Teacher Menu</p>
      </div>

      <div class="sidebar-links">
        <a class="sidebar-link" href="teacher.html">Teacher Home</a>
        <a class="sidebar-link" href="teacher-students.html">Students</a>
        <a class="sidebar-link" href="teacher-enrollment.html">Groups / Import</a>
        <a class="sidebar-link" href="teacher-active.html">Active Today</a>
        <a class="sidebar-link" href="teacher-points.html">Points / Export</a>
        <a class="sidebar-link" href="teacher-history.html">History</a>
        <a class="sidebar-link active-link" href="buzzer.html">Buzzer</a>
        <button id="logoutBtn" class="logout-btn">Logout</button>
      </div>
    </aside>

    <main class="main-content">
      <header class="topbar">
        <div>
          <h2>Buzzer</h2>
          <p>Compact live control</p>
        </div>
        <div class="topbar-right">
          <span id="teacherIdentity" class="teacher-identity">Teacher</span>
        </div>
      </header>

      <section class="buzzer-summary-grid">
        <div class="buzzer-summary-card">
          <span class="label">Active Block</span>
          <strong id="activeBlockLabel">Block 1</strong>
        </div>
        <div class="buzzer-summary-card">
          <span class="label">Block Status</span>
          <strong id="blockStatusLabel">OPEN</strong>
        </div>
        <div class="buzzer-summary-card">
          <span class="label">Session Status</span>
          <strong id="sessionStatusLabel">No active session</strong>
        </div>
        <div class="buzzer-summary-card">
          <span class="label">Present in Group</span>
          <strong id="studentCountLabel">0</strong>
        </div>
      </section>

      <details class="generator-details">
        <summary>Team Generator</summary>
        <div class="generator-content">
          <div class="generator-section">
            <h4>Working Group</h4>
            <select id="groupSelect">
              <option value="">Select group</option>
            </select>
            <div class="generator-mini-note">This selector preserves the last group you were working with.</div>
          </div>

          <div class="generator-section">
            <h4>Number of Teams</h4>
            <input id="numTeams" type="number" min="2" placeholder="Number of teams">
            <div class="generator-actions">
              <button id="createTeams">Generate Smart Teams</button>
              <button id="resetSession">Reset Session</button>
              <button id="closeSessionBtn">Close Session and Save History</button>
            </div>
          </div>
        </div>
      </details>

      <section class="buzzer-main-grid">
        <div class="buzz-panel">
          <h3 class="panel-title">Buzzer Control</h3>

          <div class="buzz-result-card">
            <h3>Current Buzz Result</h3>
            <div class="buzz-result-mini">
              <div><strong>Group:</strong> <span id="resultGroup">---</span></div>
              <div><strong>Round:</strong> <span id="resultRound">CLOSED</span></div>
              <div><strong>Current Buzz:</strong> <span id="resultBuzz">None yet</span></div>
              <div><strong>Locked Out:</strong> <span id="resultLocked">0</span></div>
            </div>
          </div>

          <div class="control-buttons-grid">
            <button id="openRoundBtn">Open Round</button>
            <button id="wrongAnswerBtn">Mark Wrong / Reopen</button>
            <button id="closeRoundBtn">Close Round</button>
            <button id="awardTeamPointBtn">+1 Team Live Point</button>
            <button id="awardStudentPointBtn">+1 Student Live Point</button>
            <button id="resetLivePointsBtn">Reset Live Points</button>
            <button id="applyStudentPointsBtn">Apply Student Live Points</button>
            <button id="applyTeamPointsBtn">Apply Team Live Points</button>
          </div>

          <p id="teacherStatusNote" class="teacher-note">Ready.</p>
        </div>

        <div class="score-panel">
          <h3 class="panel-title">Live Scores</h3>
          <div id="liveScores" class="live-score-list">
            <div class="empty-state">No active session.</div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <script type="module" src="buzzer.js"></script>
</body>
</html>